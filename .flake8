# eOVPN-Pro linting configuration / پیکربندی بررسی کیفیت کد
#
# The codebase uses bilingual (FA/EN) docstrings, so a slightly wider
# line length is intentional and matches the project style.
# کدبیس از داک‌استرینگ‌های دوزبانه (فارسی/انگلیسی) استفاده می‌کند؛
# بنابراین حداکثر طول خط کمی بیشتر انتخاب شده است.
[flake8]
max-line-length = 110
extend-ignore =
    E402,
    E203,
    W503
exclude =
    .git,
    __pycache__,
    build,
    dist/packages,
    .flatpak-builder,
    .mypy_cache,
    .ruff_cache
