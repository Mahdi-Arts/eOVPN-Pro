<?xml version="1.0" encoding="UTF-8"?>
<!--
  Read-only compatibility schema for one-way migration from upstream eOVPN.
  اسکیمای صرفاً سازگاری برای مهاجرت یک‌طرفه از eOVPN اصلی.
  The application never writes credentials to this schema.
  برنامه هیچ اطلاعات احراز هویتی در این اسکیما نمی‌نویسد.
-->
<schemalist>
  <schema path="/com/github/jkotra/eovpn/" id="com.github.jkotra.eovpn">
    <key type="b" name="notifications"><default>true</default></key>
    <key type="s" name="manager"><default>"networkmanager"</default></key>
    <key type="b" name="req-auth"><default>false</default></key>
    <key type="s" name="ca"><default>"null"</default></key>
    <key type="s" name="remote"><default>"null"</default></key>
    <key type="s" name="auth-user"><default>"null"</default></key>
    <key type="s" name="nm-active-uuid"><default>"null"</default></key>
    <key type="s" name="last-connected"><default>"null"</default></key>
    <key type="i" name="last-connected-cursor"><default>-1</default></key>
    <key type="b" name="show-flag"><default>false</default></key>
    <key type="d" name="listbox-v-adjust"><default>0</default></key>
    <key type="s" name="layout"><default>"card-h"</default></key>
    <key type="b" name="dark-theme"><default>false</default></key>
    <key type="b" name="openvpn3-dco"><default>true</default></key>
  </schema>
</schemalist>
