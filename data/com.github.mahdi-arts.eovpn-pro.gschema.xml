<?xml version="1.0" encoding="UTF-8"?>
<!--
  eOVPN-Pro GSettings Schema / اسکیمای تنظیمات eOVPN-Pro
  Keep this file in sync with `Settings.all_settings` in eovpn/eovpn_base.py
  این فایل باید با لیست `Settings.all_settings` هماهنگ بماند
-->
<schemalist>
   <schema path="/com/github/mahdi-arts/eovpn-pro/" id="com.github.mahdi-arts.eovpn-pro">
      <key type="b" name="notifications">
         <default>true</default>
      </key>
      <key type="s" name="manager">
         <default>"networkmanager"</default>
      </key>
      <key type="b" name="req-auth">
         <default>false</default>
      </key>
      <key type="s" name="ca">
         <default>"null"</default>
      </key>
      <key type="s" name="remote">
         <default>"null"</default>
      </key>
      <key type="s" name="auth-user">
         <default>"null"</default>
      </key>
      <key type="s" name="nm-active-uuid">
         <default>"null"</default>
      </key>
      <key type="s" name="last-connected">
         <default>"null"</default>
      </key>
      <key type="i" name="last-connected-cursor">
         <default>-1</default>
      </key>
      <key type="b" name="show-flag">
         <default>false</default>
      </key>
      <key type="d" name="listbox-v-adjust">
         <default>0</default>
      </key>
      <key type="s" name="layout">
         <default>"card-h"</default>
      </key>
      <key type="b" name="dark-theme">
         <default>false</default>
      </key>
      <key type="b" name="openvpn3-dco">
         <default>true</default>
      </key>
      <key type="b" name="auto-reconnect">
         <default>false</default>
      </key>
      <key type="as" name="favorite-configs">
         <default>[]</default>
      </key>
      <key type="s" name="language">
         <default>"en"</default>
      </key>
   </schema>
</schemalist>
