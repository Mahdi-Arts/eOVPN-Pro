using Gtk 4.0;

// Editable Blueprint source for otp.ui.
// منبع قابل‌ویرایش Blueprint برای otp.ui.
Window otp_window {
  title: _("Authentication Challenge");
  default-width: 440;
  resizable: false;
  modal: true;

  Box {
    orientation: vertical;
    spacing: 12;
    margin-top: 24;
    margin-bottom: 24;
    margin-start: 24;
    margin-end: 24;

    Image {
      icon-name: "dialog-password-symbolic";
      pixel-size: 40;
      styles ["challenge-icon"]
    }
    Label {
      label: _("Additional verification is required");
      styles ["title-3"]
    }
    Label prompt_label {
      label: _("Enter the one-time code or challenge response supplied by your VPN provider.");
      wrap: true;
      justify: center;
      styles ["dim-label"]
    }
    PasswordEntry otp_entry {
      placeholder-text: _("Verification code");
      show-peek-icon: true;
      max-length: 64;
      activates-default: true;
    }
    Button submit {
      label: _("Verify");
      sensitive: false;
      receives-default: true;
      styles ["suggested-action"]
    }
  }
}
