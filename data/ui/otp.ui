<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <object class="GtkWindow" id="otp_window">
    <property name="title" translatable="true">Authentication Challenge</property>
    <property name="default-width">440</property>
    <property name="resizable">false</property>
    <property name="modal">true</property>
    <child>
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <property name="spacing">12</property>
        <property name="margin-top">24</property>
        <property name="margin-bottom">24</property>
        <property name="margin-start">24</property>
        <property name="margin-end">24</property>
        <child>
          <object class="GtkImage">
            <property name="icon-name">dialog-password-symbolic</property>
            <property name="pixel-size">40</property>
            <style><class name="challenge-icon"/></style>
          </object>
        </child>
        <child>
          <object class="GtkLabel">
            <property name="label" translatable="true">Additional verification is required</property>
            <style><class name="title-3"/></style>
          </object>
        </child>
        <child>
          <object class="GtkLabel" id="prompt_label">
            <property name="label" translatable="true">Enter the one-time code or challenge response supplied by your VPN provider.</property>
            <property name="wrap">true</property>
            <property name="justify">center</property>
            <style><class name="dim-label"/></style>
          </object>
        </child>
        <child>
          <object class="GtkPasswordEntry" id="otp_entry">
            <property name="placeholder-text" translatable="true">Verification code</property>
            <property name="show-peek-icon">true</property>
            <property name="max-length">64</property>
            <property name="activates-default">true</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="submit">
            <property name="label" translatable="true">Verify</property>
            <property name="sensitive">false</property>
            <property name="receives-default">true</property>
            <style><class name="suggested-action"/></style>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
