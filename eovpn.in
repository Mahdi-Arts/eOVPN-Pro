#!/usr/bin/env python3

import sys
import os
import locale
import gettext

sys.path.insert(1, '@PYTHON_DIR@')
pkgdatadir = '@PKG_DATADIR@'
localedir = '@LOCALE_DIR@'

# A Meson build may place this script beside an ``eovpn.py`` file. Remove that
# build directory from the import path before importing the real package, or
# a direct source/build-tree restart can shadow ``eovpn`` with this script.
if os.path.basename(__file__) == "eovpn.py":
    _launcher_dir = os.path.dirname(os.path.abspath(__file__))
    while _launcher_dir in sys.path:
        sys.path.remove(_launcher_dir)

from gi.repository import Gio

import logging

from eovpn.application import launch_eovpn

if os.getenv("EOVPN_DEBUG") is not None:
    logging.basicConfig(level=os.getenv("EOVPN_DEBUG"), format='%(levelname)s:%(name)s.py:%(funcName)s:%(message)s')


if __name__ == "__main__":

    try:
        settings = Gio.Settings.new("com.github.mahdi-arts.eovpn-pro")
        lang = settings.get_string("language")
    except Exception:
        lang = "en"

    if lang:
        os.environ["LANGUAGE"] = lang

    locale.bindtextdomain('eovpn', localedir)
    locale.textdomain('eovpn')
    gettext.bindtextdomain('eovpn', localedir)
    gettext.textdomain('eovpn')

    resource = Gio.resource_load(os.path.join(pkgdatadir, 'com.github.mahdi-arts.eovpn-pro.gresource'))
    Gio.Resource._register(resource)
    
    exit_status = launch_eovpn()
    sys.exit(exit_status)
