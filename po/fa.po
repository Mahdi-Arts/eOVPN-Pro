msgstr "اسپانسر و حمایت مالی"

msgid "Speed Test"
msgstr "تست سرعت"

msgid "Test latency of all VPN servers"
msgstr "تست تاخیر همه سرورهای VPN"

msgid "Sort"
msgstr "مرتب‌سازی"

msgid "Sort servers by lowest latency"
msgstr "مرتب‌سازی سرورها بر اساس کمترین تاخیر"

